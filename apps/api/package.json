{
  "name": "@clinic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply clinic_db_local --local",
    "db:migrate:staging": "wrangler d1 migrations apply clinic_db_staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply clinic_db --remote --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@clinic/shared": "*",
    "@hono/zod-validator": "^0.4.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
